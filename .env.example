# Copy to .env.local (used by Next.js; Studio syncs SANITY_STUDIO_* automatically)
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Optional Sanity Studio aliases (same values as above).
# `npm run sanity:dev` also generates `.env.development.local` from NEXT_PUBLIC_*.
# SANITY_STUDIO_PROJECT_ID=your_project_id
# SANITY_STUDIO_DATASET=production

# Optional: custom hostname when running `npm run sanity:deploy`
# SANITY_STUDIO_HOSTNAME=your-portfolio
